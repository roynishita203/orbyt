# Stellar secret key used to submit charge() transactions. This key pays
# transaction fees only -- charge() is permissionless, so this key carries
# no special privilege in the SubVault contract itself.
KEEPER_SECRET_KEY=SC...

# Deployed SubVault contract address (testnet).
CONTRACT_ID=C...

# Soroban RPC endpoint.
RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase matching RPC_URL.
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# How often to poll get_due_subscriptions(), in milliseconds.
POLL_INTERVAL_MS=300000
